                                     "blocks":  {
                                                    "question_1":  {
                                                                       "type":  "question",
                                                                       "settings":  {
                                                                                        "heading":  "Are your products vegan?",
                                                                                        "row_content":  "\u003cp\u003eYes, all our products are 100% vegan. We are proud to offer a wide range of food that are free from any animal-derived ingredients or by-products.\u003c/p\u003e"
                                                                                    }
                                                                   },
                                                    "question_2":  {
                                                                       "type":  "question",
                                                                       "settings":  {
                                                                                        "heading":  "Are your products organic?",
                                                                                        "row_content":  "\u003cp\u003eAbsolutely! We prioritize the use of organic and natural ingredients in our formulations. Our products are carefully crafted to harness the power of nature.\u003c/p\u003e"
                                                                                    }
                                                                   },
                                                    "question_3":  {
                                                                       "type":  "question",
                                                                       "settings":  {
                                                                                        "heading":  "Are your products cruelty-free?",
                                                                                        "row_content":  "\u003cp\u003eYes, we are proud to be a cruelty-free brand. We do not conduct any animal testing, and our products are certified cruelty-free by reputable organizations. We believe in the ethical treatment of animals and ensure that our products are developed without any harm to our furry friends.\u003c/p\u003e"
                                                                                    }
                                                                   },
                                                    "question_4":  {
                                                                       "type":  "question",
                                                                       "settings":  {
                                                                                        "heading":  "What are the main ingredients used in your products?",
                                                                                        "row_content":  "\u003cp\u003eWe use a wide range of natural and organic ingredients in our products. Each product has a unique formulation designed to provide specific benefits. Common ingredients you\u0027ll find in our products include botanical extracts, plant oils, vitamins, and minerals, all carefully selected for their nourishing your body.\u003c/p\u003e"
                                                                                    }
                                                                   },
                                                    "question_5":  {
                                                                       "type":  "question",
                                                                       "settings":  {
                                                                                        "heading":  "Do you offer products for specific skin concerns?",
                                                                                        "row_content":  "\u003cp\u003eYes, we offer a variety of products tailored to address specific skin concerns such as dryness, acne, aging, and sensitivity. Our range includes moisturizers, serums, cleansers, masks, and more, each formulated to target and improve specific skin issues. Explore our product descriptions or reach out to our customer support team for personalized recommendations.\u003c/p\u003e"
                                                                                    }
                                                                   }
