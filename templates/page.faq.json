                                                   },
                                      "blocks":  {
                                                     "question_1":  {
                                                                        "type":  "question",
                                                                        "settings":  {
                                                                                         "heading":  "Do you offer international shipping?",
                                                                                         "row_content":  "\u003cp\u003eYes, we offer international shipping to many countries. However, please note that international shipping times and costs may differ from domestic shipping. Make sure to review the shipping options available for your country during the checkout process.\u003c/p\u003e"
                                                                                     }
                                                                    },
                                                     "question_2":  {
                                                                        "type":  "question",
                                                                        "settings":  {
                                                                                         "heading":  "How long does shipping take?",
                                                                                         "row_content":  "\u003cp\u003eShipping times can vary depending on your location and the shipping method chosen. Typically, domestic orders within [Country] are delivered within 3-5 business days. International shipping times may range from 7-14 business days, depending on the destination. Please note that these are estimated times and delays may occur due to unforeseen circumstances or customs procedures.\u003c/p\u003e"
                                                                                     }
                                                                    },
                                                     "question_3":  {
                                                                        "type":  "question",
                                                                        "settings":  {
                                                                                         "heading":  "What is your return policy?",
                                                                                         "row_content":  "\u003cp\u003eWe want you to be completely satisfied with your purchase. If for any reason you are not happy with your order, we accept returns within 30 days of the original purchase date. Please ensure that the product is unopened, unused, and in its original packaging for a successful return. Kindly refer to our Returns Policy on our website for detailed instructions on initiating a return.\u003c/p\u003e"
                                                                                     }
                                                                    },
                                                     "question_4":  {
                                                                        "type":  "question",
                                                                        "settings":  {
                                                                                         "heading":  "How do I initiate a return?",
                                                                                         "row_content":  "\u003cp\u003e Initiating a return is easy. Simply contact our customer support team with your order details and reason for return. Our team will guide you through the process and provide you with further instructions on returning the product. Please note that return shipping costs may be the responsibility of the customer, unless the return is due to an error on our part.\u003c/p\u003e"
                                                                                     }
                                                                    },
                                                     "question_5":  {
                                                                        "type":  "question",
                                                                        "settings":  {
                                                                                         "heading":  "What if my order arrives damaged or there is an issue with the product?",
                                                                                         "row_content":  "\u003cp\u003eWe apologize for any inconvenience caused by a damaged or defective product. If you receive a damaged item or there is an issue with the product, please contact our customer support team immediately. We will gladly assist you in resolving the issue and arranging a replacement or refund as necessary.\u003c/p\u003e"
                                                                                     }
                                                                    }
                                                 },
