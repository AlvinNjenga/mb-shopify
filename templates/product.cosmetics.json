    "product_testimonials": {
      "type": "product-story",
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": { "heading": "Peptide Lift Oil", "content": "<p>This oil instantly became part of my daily routine. It feels lightweight yet deeply nourishing, leaving my skin soft, radiant, and beautifully hydrated all day.</p>", "author": "Rob Doe", "rating": 5, "reference_card": "1" }
        },
        "item_2": {
          "type": "item",
          "settings": { "heading": "Complete Self-Care Beauty Gift Set", "content": "<p>Such a beautiful set! Every product feels luxurious and thoughtfully designed. It's perfect for relaxing self-care moments and makes an amazing gift too.</p>", "author": "Esther Love", "rating": 4, "reference_card": "2" }
        },
        "item_3": {
          "type": "item",
          "settings": { "heading": "Facial ice globes", "content": "<p>These cooling globes feel incredible on the skin. They instantly refresh my face, reduce puffiness, and leave my complexion looking brighter and more awake.</p>", "author": "John Kindani", "rating": 3, "reference_card": "3" }
        },
        "item_4": {
          "type": "item",
          "settings": { "heading": "Luxury Self-Care & Skincare Spa Set", "content": "<p>This spa set instantly elevates my skincare routine. The products feel luxurious and create a calming ritual that makes every evening more relaxing.</p>", "author": "Brian Kindani", "rating": 5, "reference_card": "4" }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3",
        "item_4"
      ],
