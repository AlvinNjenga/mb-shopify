{
  "sections": {
    "sticky_purchase": {
      "type": "sticky-product-bar",
      "settings": {
        "enabled": true,
        "show_desktop": true,
        "show_mobile": true,
        "color_scheme": "scheme-1"
      }
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "product_promotion": {
          "type": "product_promotion",
          "settings": { "enabled": true, "color_scheme": "scheme-1" }
        },
        "about_product": {
          "type": "product_overview",
          "settings": { "heading": "About the product", "metafield_key": "short_introduction", "show_details": true, "open": false }
        },
        "how_to_use": {
          "type": "product_overview",
          "settings": { "heading": "How to Use", "metafield_key": "usage", "show_details": false, "open": true }
        },
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "hide_single_value_options": true,
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "introduction_only": true
          }
        },
        "complementary_products": {
          "type": "complementary",
          "settings": {
            "block_heading": "Goes well with",
            "make_collapsible_row": false,
            "product_list_limit": 6,
            "products_per_page": 2,
            "pagination_style": "counter",
            "image_ratio": "square",
            "enable_quick_add": false,
            "manual_products": []
          }
        },
        "product_information": {
          "type": "purchase_information",
          "settings": {
            "heading": "Product Info",
            "icon": "clipboard",
            "source": "content",
            "content": "{{ product.metafields.custom.composition | metafield_tag }}", "metafield_key": "composition"
          }
        },
        "product_support": {
          "type": "purchase_information",
          "settings": {
            "heading": "Support",
            "icon": "chat_bubble",
            "source": "contact",
            "content": "<p>For questions or feedback, please <a href=\"/pages/contact\">contact our team</a>. We aim to reply promptly during our usual business hours.</p>"
          }
        },
        "shipping_returns": {
          "type": "purchase_information",
          "settings": {
            "heading": "Shipping and Returns",
            "icon": "truck",
            "source": "shipping_returns",
            "content": "<p>Changed your mind? You can return or exchange your purchase within <strong>30 days</strong>, with <strong>no return charge</strong>. Choose a replacement product, store credit, or a refund to the payment method used for your order.</p>"
          }
        },
        "delivery_note": {
          "type": "delivery_note",
          "settings": {
            "text": ""
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "inventory",
        "price",
        "delivery_note",
        "description",
        "product_information",
        "shipping_returns",
        "product_support",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "complementary_products",
        "about_product",
        "how_to_use",
        "product_promotion"
      ],
      "settings": {
        "enable_olivelle_layout": true,
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "hide",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 24,
        "reference_product_layout": true
      }
    },
    "related-products": {
      "type": "related-products",
      "disabled": true,
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 36,
        "padding_bottom": 68,
        "reference_layout": true
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "scrolling_offers": {
      "type": "product-story",
      "settings": { "heading": "Store offers", "layout": "offers", "reference_layout": true, "panel_color": "#e9e4fc", "padding_top": 0, "padding_bottom": 0 },
      "blocks": {
        "offer_1": { "type": "item", "settings": { "heading": "FREE SHIPPING", "content": "<p>on all orders over $100</p>" } },
        "offer_2": { "type": "item", "settings": { "heading": "10% OFF", "content": "<p>your first order | Use code: PROMO10</p>" } },
        "offer_3": { "type": "item", "settings": { "heading": "EASY RETURNS", "content": "<p>30-day postage paid returns</p>" } }
      },
      "block_order": ["offer_1", "offer_2", "offer_3"]
    },
    "brand_stories": {
      "type": "product-story",
      "settings": { "heading": "", "layout": "brand_stories", "reference_layout": true, "use_product_images": true, "panel_color": "#efecf7", "padding_top": 36, "padding_bottom": 0 },
      "blocks": {
        "story_1": { "type": "item", "settings": { "heading": "Care for your skin", "content": "{{ product.metafields.custom.benefits | metafield_tag }}", "metafield_key": "benefits", "link_label": "Explore products", "link": "/collections/all" } },
        "story_2": { "type": "item", "settings": { "heading": "Your skincare ritual", "content": "{{ product.metafields.custom.usage_summary | metafield_tag }}", "metafield_key": "usage", "link_label": "Explore products", "link": "/collections/all" } },
        "story_3": { "type": "item", "settings": { "heading": "Texture and finish", "content": "{{ product.metafields.custom.finish | metafield_tag }}", "metafield_key": "finish", "link_label": "Explore products", "link": "/collections/all" } }
      },
      "block_order": ["story_1", "story_2", "story_3"]
    },
    "product_benefits": {
      "type": "product-story",
      "settings": { "heading": "", "layout": "benefits", "reference_layout": true, "use_product_images": true, "use_product_benefit_copy": true, "padding_top": 48, "padding_bottom": 48 },
      "blocks": {
        "benefit_1": { "type": "item", "settings": { "heading": "Key ingredients", "content": "{{ product.metafields.custom.composition | metafield_tag }}", "metafield_key": "composition" } },
        "benefit_2": { "type": "item", "settings": { "heading": "Recommended for", "content": "{{ product.metafields.custom.recommended_for | metafield_tag }}", "metafield_key": "recommended_for" } },
        "benefit_3": { "type": "item", "settings": { "heading": "Texture and finish", "content": "{{ product.metafields.custom.finish | metafield_tag }}", "metafield_key": "finish" } }
      },
      "block_order": ["benefit_1", "benefit_2", "benefit_3"]
    },
