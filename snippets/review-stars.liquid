<span class="review-stars" role="img" aria-label="{{ rating }} out of 5 stars">
  {% for i in (1..5) %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 2 3 6.1 6.7 1-4.8 4.7 1.1 6.7-6-3.2-6 3.2 1.1-6.7L2.3 9.1l6.7-1Z" fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1"/></svg>{% endfor %}
</span>
