{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'section-hero-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<div class="hero-product-collection page-width">
  <slider-component>
    <div class="slider-buttons">
      <button type="button" name="previous" class="slider-button slider-button--prev" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-Oils-{{ section.id }}"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></button>
      <button type="button" name="next" class="slider-button slider-button--next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-Oils-{{ section.id }}"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></button>
    </div>
    <ul id="Slider-Oils-{{ section.id }}" class="hero-product-collection__list grid product-grid grid--4-col-desktop grid--1-col-tablet-down slider slider--desktop slider--tablet" role="list">
      {% for product in section.settings.featured_collection.products limit: section.settings.products_to_show %}
        <li id="Slide-Oils-{{ section.id }}-{{ forloop.index }}" class="grid__item slider__slide">
          {% render 'card-product', card_product: product, media_aspect_ratio: 'square', show_secondary_image: true, lazy_load: true, section_id: section.id, quick_add: 'standard', product_view_context: 'collection' %}
        </li>
      {% else %}
        {% assign reference_names = 'Radiance Oil,Balance Oil,Repair Oil,Peptide Lift Oil,Brightening Oil,Glow Oil,Nourishing Oil' | split: ',' %}
        {% for name in reference_names limit: section.settings.products_to_show %}
          {% assign i = forloop.index %}
          <li id="Slide-Oils-{{ section.id }}-{{ i }}" class="grid__item slider__slide">
            {% liquid
              assign extension = '.webp'
              if i <= 3 or i == 6
                assign extension = '.jpg'
              endif
              assign reference_image = 'hero-oil-product-' | append: i | append: extension
            %}
            <a class="hero-product-collection__reference" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">
              <div class="hero-product-collection__reference-image">
                <div class="media media--square"><img src="{{ reference_image | asset_url }}" width="750" height="750" loading="lazy" alt="{{ name | escape }}"></div>
                <span class="hero-product-collection__reference-action" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor"><path d="M4 6h12M4 10h12M4 14h12" stroke-linecap="round"/></svg></span>
              </div>
              <h3>{{ name | escape }}</h3>
            </a>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </slider-component>
</div>
