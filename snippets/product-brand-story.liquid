{% comment %}Reference brand slide. Accepts block, image and item_text.{% endcomment %}
{%- if image != blank -%}
  {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 769px) 65vw, 100vw', class: 'product-brand__image' }}
{%- endif -%}
<div class="product-brand__copy">
  {%- if block.settings.heading != blank -%}<h3 class="product-brand__heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
  {%- if block.settings.link != blank and block.settings.link_label != blank -%}
    <a class="product-brand__link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
  {%- endif -%}
  {%- if item_text != blank -%}<div class="product-brand__caption rte">{{ item_content }}</div>{%- endif -%}
</div>
