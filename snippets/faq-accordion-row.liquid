{% comment %}Reusable FAQ row. Receives: block, section_id, open.{% endcomment %}
<div class="faq-group__row accordion" {{ block.shopify_attributes }}>
  <details id="Details-{{ section_id }}-{{ block.id }}"{% if open %} open{% endif %}>
    <summary id="Summary-{{ section_id }}-{{ block.id }}">
      {% render 'icon-accordion', icon: 'question_mark' %}
      <h3 class="accordion__title h4">{{ block.settings.heading | escape }}</h3>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </summary>
    <div class="accordion__content rte" id="Answer-{{ section_id }}-{{ block.id }}" role="region" aria-labelledby="Summary-{{ section_id }}-{{ block.id }}">
      {{ block.settings.row_content }}
    </div>
  </details>
</div>
