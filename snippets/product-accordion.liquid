{% comment %}Optional Dawn accordion. Accepts block, section_id and optional content override.{% endcomment %}
{%- assign accordion_body = content | default: block.settings.content -%}
{%- assign accordion_content = accordion_body | strip_html | strip -%}
{%- assign accordion_page_content = block.settings.page.content | strip -%}
{%- if accordion_content != blank or accordion_page_content != blank -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section_id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: block.settings.icon %}
          <h2 class="h4 accordion__title inline-richtext">
            {{ block.settings.heading | default: block.settings.page.title | escape }}
          </h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section_id }}">
        {{ accordion_body }}
        {{ block.settings.page.content }}
      </div>
    </details>
  </div>
{%- endif -%}
