{{ 'section-info-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'info-cards.js' | asset_url }}" defer="defer"></script>

<div class="reference-infocards color-{{ section.settings.color_scheme }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="reference-infocards__grid">
    {% for block in section.blocks %}
      <details class="reference-infocard" style="--card-background: {{ block.settings.background }}; --card-color: {{ block.settings.text_color }};" {{ block.shopify_attributes }}>
        <summary class="reference-infocard__summary">
          {% render 'infocard-image', block: block %}
          <span class="reference-infocard__subtitle">{{ block.settings.subtitle | escape }}</span>
          <h2 class="reference-infocard__title">{{ block.settings.title | escape }}</h2>
        </summary>
        <div class="reference-infocard__panel" role="dialog" aria-modal="true" aria-labelledby="InfocardTitle-{{ section.id }}-{{ block.id }}" tabindex="-1">
          <button class="reference-infocard__close" type="button" aria-label="{{ 'accessibility.close' | t }}">{{ 'icon-close.svg' | inline_asset_content }}</button>
          <div class="reference-infocard__header">
            {% render 'infocard-image', block: block %}
            <div>
              <p class="reference-infocard__subtitle">{{ block.settings.subtitle | escape }}</p>
              <h2 class="reference-infocard__title" id="InfocardTitle-{{ section.id }}-{{ block.id }}">{{ block.settings.title | escape }}</h2>
            </div>
          </div>
          <div class="reference-infocard__body rte">{{ block.settings.text }}</div>
        </div>
      </details>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Info cards",
  "tag": "section",
  "class": "section section-info-cards",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "max_blocks": 4,
  "blocks": [{
    "type": "card",
    "name": "Info card",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "reference_image", "label": "Reference image", "default": "1", "options": [{ "value": "1", "label": "Clean beauty" }, { "value": "2", "label": "Beauty tools" }, { "value": "3", "label": "Self-care" }, { "value": "4", "label": "Vegan beauty" }, { "value": "none", "label": "None" }] },
      { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Clean Beauty" },
      { "type": "text", "id": "title", "label": "Heading", "default": "Natural. Gentle. Skin-Loving." },
      { "type": "richtext", "id": "text", "label": "Expanded content", "default": "<p>Discover our skincare essentials.</p>" },
      { "type": "color", "id": "background", "label": "Background", "default": "#FFC3E9" },
      { "type": "color", "id": "text_color", "label": "Text", "default": "#34212E" }
    ]
  }],
  "presets": [{ "name": "Info cards", "blocks": [
    { "type": "card", "settings": { "reference_image": "1" } },
    { "type": "card", "settings": { "reference_image": "2", "subtitle": "Skin Care Tools", "title": "Advanced Beauty Tools", "background": "#FFF1F9" } },
    { "type": "card", "settings": { "reference_image": "3", "subtitle": "Self-Care Ritual", "title": "Relax. Restore. Glow." } },
    { "type": "card", "settings": { "reference_image": "4", "subtitle": "Vegan Beauty", "title": "Kind to Skin & Planet", "background": "#FFF1F9" } }
  ] }]
}
{% endschema %}
