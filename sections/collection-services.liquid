{{ 'section-collection-services.css' | asset_url | stylesheet_tag }}
<div class="collection-services color-{{ section.settings.color_scheme }} gradient">
  <ul class="collection-services__list" role="list">
    {%- for block in section.blocks -%}
      <li class="collection-services__card" {{ block.shopify_attributes }}>
        <div>
          <h2>{{ block.settings.heading | escape }}</h2>
          <p>{{ block.settings.text | escape }}</p>
        </div>
        <span class="collection-services__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}{{ 'icon-truck.svg' | inline_asset_content }}
            {%- when 'return' -%}{{ 'icon-return.svg' | inline_asset_content }}
            {%- when 'support' -%}{{ 'icon-chat-bubble.svg' | inline_asset_content }}
            {%- when 'payment' -%}{{ 'icon-lock.svg' | inline_asset_content }}
          {%- endcase -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- if section.settings.show_social -%}
  {%- capture social_links -%}{% render 'social-icons', class: 'collection-social-rail' %}{%- endcapture -%}
  {%- if social_links contains '<li' -%}
    <nav aria-label="{{ section.settings.social_label | escape }}" class="collection-social">{{ social_links }}</nav>
  {%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "Collection services",
  "tag": "section",
  "class": "section-collection-services",
  "enabled_on": { "templates": ["collection"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "social_label", "label": "Social navigation label", "default": "Social media" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_social", "label": "Show floating social links", "default": true, "info": "Uses the links configured in Theme settings > Social media." }
  ],
  "blocks": [{
    "type": "service", "name": "Service",
    "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "text", "id": "text", "label": "Description" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "truck", "label": "Shipping" },
        { "value": "return", "label": "Returns" },
        { "value": "support", "label": "Support" },
        { "value": "payment", "label": "Payment" }
      ] }
    ]
  }],
  "presets": [{ "name": "Collection services" }]
}
{% endschema %}
