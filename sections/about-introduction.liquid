{{ 'section-about-introduction.css' | asset_url | stylesheet_tag }}
{% render 'about-fonts' %}

<div class="about-intro" style="--intro-padding-top: {{ section.settings.padding_top }}px; --intro-padding-bottom: {{ section.settings.padding_bottom }}px; --intro-highlight: {{ section.settings.highlight_color }};">
  <div class="about-intro__content">
    {% if section.settings.show_decoration %}
      <div class="about-intro__decoration" aria-hidden="true">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 300 | image_tag: width: 130, height: 130, loading: 'lazy', alt: '' }}
        {% else %}
          <img src="{{ 'about-intro-arrows.gif' | asset_url }}" alt="" width="130" height="130" loading="lazy">
        {% endif %}
      </div>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="about-intro__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="about-intro__text rte">{{ section.settings.text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "About introduction",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "show_decoration", "label": "Show decoration", "default": true },
    { "type": "image_picker", "id": "image", "label": "Decoration image", "info": "Leave blank to use the reference's animated arrows." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Italic text receives a decorative underline.", "default": "A Journey to <em>Natural</em> Beauty" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We believe skincare should be more than a routine — it should be a moment of balance, care, and renewal. Our philosophy blends nourishing botanical oils, thoughtfully crafted beauty tools, and mindful self-care rituals designed to support healthy, radiant skin.</p>" },
    { "type": "color", "id": "highlight_color", "label": "Underline color", "default": "#d4c4d9" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "About introduction" }]
}
{% endschema %}
