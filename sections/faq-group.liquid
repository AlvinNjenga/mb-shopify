{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{% render 'faq-styles' %}
<script src="{{ 'faq-group.js' | asset_url }}" defer="defer"></script>

<faq-group class="faq-group{% if section.settings.alternate_background %} faq-group--alternate{% endif %}" style="--faq-padding-top: {{ section.settings.padding_top }}px; --faq-padding-bottom: {{ section.settings.padding_bottom }}px;"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="faq-group__inner page-width page-width--narrow">
    {%- if section.settings.caption != blank -%}
      <p class="caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-group__heading h1">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign open_row = false
        if section.settings.open_first_collapsible_row and forloop.first
          assign open_row = true
        endif
      -%}
      {% render 'faq-accordion-row', block: block, section_id: section.id, open: open_row %}
    {%- endfor -%}
  </div>
</faq-group>

{% schema %}
{
  "name": "FAQ group",
  "tag": "section",
  "class": "section faq-group-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "checkbox", "id": "alternate_background", "label": "White background with grey rows", "default": false },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Use a unique ID, such as orders. Link to it with #orders." },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Support FAQs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first_collapsible_row", "label": "Open first question", "default": false }
  ],
  "blocks": [{
    "type": "question",
    "name": "Question",
    "settings": [
      { "type": "text", "id": "heading", "label": "Question", "default": "Frequently asked question" },
      { "type": "richtext", "id": "row_content", "label": "Answer" }
    ]
  }],
  "presets": [{ "name": "FAQ group", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
