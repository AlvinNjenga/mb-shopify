{{ 'section-about-brand-story.css' | asset_url | stylesheet_tag }}
{{ 'section-about-sustainability.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about-looping-video.js' | asset_url }}" defer="defer"></script>
{% render 'about-fonts' %}

<div class="about-quality" style="--quality-background: {{ section.settings.background_color }}; --quality-padding: {{ section.settings.padding }}px; --quality-mobile-gap: {{ section.settings.mobile_gap }}px;">
  <div class="about-quality__grid">
    <div class="about-quality__media">
      <about-looping-video>
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, preload: 'metadata', image_size: '1200x', aria-label: section.settings.video_label }}
        {% else %}
          <video autoplay loop muted playsinline controls preload="metadata" poster="{{ 'about-quality-poster.jpg' | asset_url }}" aria-label="{{ section.settings.video_label | escape }}">
            <source src="{{ 'about-quality.mp4' | asset_url }}" type="video/mp4">
          </video>
        {% endif %}
        <button class="about-quality__toggle" type="button" hidden data-pause-label="Pause video" data-play-label="Play video" aria-label="Pause video">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path data-pause d="M4 2h3v12H4zm5 0h3v12H9z" fill="currentColor"/><path data-play d="m4 2 10 6-10 6z" fill="currentColor" hidden/></svg>
        </button>
      </about-looping-video>
    </div>
    <div class="about-quality__content about-story__content">
      {% render 'about-media-text-content', section: section %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About sustainability",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "video", "id": "video", "label": "Video", "info": "Leave blank to use the reference skincare video." },
    { "type": "text", "id": "video_label", "label": "Video description", "default": "A calming facial massage with a skincare tool" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quality & Sustainability" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We believe beauty should be as mindful as it is effective. Our products are created with carefully selected ingredients, skin-friendly materials, and thoughtful design to support both your wellbeing and the planet. From nourishing botanical oils to durable beauty tools and calming self-care essentials, every detail is chosen to deliver quality you can trust.</p>" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFC3E9" },
    { "type": "range", "id": "padding", "label": "Top and bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile and tablet top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "About sustainability" }]
}
{% endschema %}
