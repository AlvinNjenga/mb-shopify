{{ 'section-ritual-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ritual-slider.js' | asset_url }}" defer="defer"></script>

<div class="ritual-slider-section color-{{ section.settings.color_scheme }} gradient" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="ritual-slider-section__width">
    <ritual-slider class="ritual-slider" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.accessibility_label | escape }}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_speed | times: 1000 }}">
      <ul class="ritual-slider__slides" id="RitualSlides-{{ section.id }}" role="list">
        {% for block in section.blocks %}
          <li class="ritual-slider__slide{% if forloop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" data-block-id="{{ block.id }}" {% unless forloop.first %}aria-hidden="true" inert{% endunless %} {{ block.shopify_attributes }}>
            {% render 'ritual-slide-image', block: block %}
            <div class="ritual-slider__content">
              <h2 class="ritual-slider__heading">{{ block.settings.heading | escape }}</h2>
              {% if block.settings.button_label != blank and block.settings.link != blank %}
                <a class="ritual-slider__link" href="{{ block.settings.link }}">{{ block.settings.button_label | escape }}</a>
              {% endif %}
              <div class="ritual-slider__caption">{{ block.settings.caption | escape }}</div>
            </div>
          </li>
        {% endfor %}
      </ul>
      {% if section.blocks.size > 1 %}
        <div class="ritual-slider__controls" hidden>
          <button type="button" class="ritual-slider__arrow" data-previous aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}" aria-controls="RitualSlides-{{ section.id }}"><span aria-hidden="true">⟵</span></button>
          <span class="ritual-slider__counter"><span data-current>1</span><span aria-hidden="true"> / </span>{{ section.blocks.size }}</span>
          <button type="button" class="ritual-slider__arrow" data-next aria-label="{{ 'sections.slideshow.next_slideshow' | t }}" aria-controls="RitualSlides-{{ section.id }}"><span aria-hidden="true">⟶</span></button>
          {% if section.settings.autoplay %}<button type="button" class="ritual-slider__pause" data-pause aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}" data-pause-label="{{ 'sections.slideshow.pause_slideshow' | t }}" data-play-label="{{ 'sections.slideshow.play_slideshow' | t }}"><span aria-hidden="true">Ⅱ</span></button>{% endif %}
        </div>
      {% endif %}
    </ritual-slider>
  </div>
</div>

{% schema %}
{
  "name": "Ritual slider",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Skincare rituals" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Change slides every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [{
    "type": "slide", "name": "Slide",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
      { "type": "select", "id": "reference_image", "label": "Reference image", "default": "healthy", "options": [{ "value": "healthy", "label": "Healthy skin" }, { "value": "glow", "label": "Daily glow" }, { "value": "self-care", "label": "Self-care sets" }] },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Healthy Skin Ritual" },
      { "type": "textarea", "id": "caption", "label": "Caption", "default": "Nourish your skin with botanical oils and beauty tools designed to hydrate, restore, and reveal your natural radiance." },
      { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop Now" },
      { "type": "url", "id": "link", "label": "Link" }
    ]
  }],
  "presets": [{ "name": "Ritual slider", "blocks": [{ "type": "slide", "settings": { "link": "shopify://collections/all", "button_label": "Order Now" } }, { "type": "slide", "settings": { "reference_image": "glow", "heading": "Daily Glow Ritual", "caption": "Nourish and hydrate your skin with botanical facial oils designed to enhance your natural radiance and support a healthy, glowing complexion.", "link": "shopify://collections/facial-oils" } }, { "type": "slide", "settings": { "reference_image": "self-care", "heading": "Self-Care Beauty Sets", "caption": "Discover beautifully curated skincare sets designed to nourish your skin and elevate your daily beauty ritual. Perfect for glowing skin or thoughtful self-care gifts.", "button_label": "Explore Sets", "link": "shopify://collections/all" } }] }]
}
{% endschema %}
