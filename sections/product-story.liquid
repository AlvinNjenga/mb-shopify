{{ 'section-product-story.css' | asset_url | stylesheet_tag }}
{%- if section.settings.layout == 'brand_stories' -%}
  {{ 'section-product-brand-stories.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- liquid
  assign body = section.settings.content
  assign body_text = body | strip_html | strip
  assign text_only = false
  if section.settings.layout == 'text'
    assign text_only = true
  endif
  if body_text == blank
    capture body
      render 'product-metafield-content', product: product, key: section.settings.metafield_key
    endcapture
  endif
  assign body_text = body | strip_html | strip
-%}
{%- capture story_items -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product_detail' -%}
      {% render 'product-detail', product: product, block: block, hide_images: text_only, heading_tag: 'h3' %}
    {%- else -%}
      {%- assign fallback_image = nil -%}
      {%- assign benefit_copy = nil -%}
      {%- if section.settings.layout == 'benefits' and section.settings.use_product_benefit_copy -%}
        {%- assign benefit_copy = product.metafields.custom.benefit_card_copy.value[forloop.index0] -%}
      {%- endif -%}
      {%- if section.settings.use_product_images and section.settings.layout == 'brand_stories' or section.settings.use_product_images and section.settings.layout == 'benefits' -%}
        {%- assign fallback_image = product.images[forloop.index0] -%}
      {%- endif -%}
      {% render 'product-story-item', block: block, layout: section.settings.layout, hide_images: text_only, fallback_image: fallback_image, benefit_copy: benefit_copy %}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign story_items = story_items | strip -%}
{%- if story_items == blank and section.settings.layout == 'gallery' and section.settings.use_product_images -%}
  {%- capture story_items -%}
    {%- for image in product.images limit: 8 -%}
      <div class="product-story__item product-story__item--image">
        <a href="{{ product.url }}">
          {{ image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 350, 600, 700, 800', sizes: '(max-width: 990px) 350px, 300px' }}
        </a>
      </div>
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign story_items = story_items | strip -%}
{%- endif -%}
{%- if section.settings.layout == 'marquee' and story_items == blank and body_text != blank -%}
  {%- capture story_items -%}<div class="product-story__item"><h3>{{ body_text | escape }}</h3></div>{%- endcapture -%}
{%- endif -%}
{%- liquid
  assign has_content = false
  if body_text != blank or story_items != blank
    assign has_content = true
  elsif section.settings.image != blank and text_only == false
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  <div class="product-story{% if section.settings.reference_layout %} product-story--reference product-story--{{ section.settings.layout }}{% endif %} color-{{ section.settings.color_scheme }} gradient" style="--story-top: {{ section.settings.padding_top }}px; --story-bottom: {{ section.settings.padding_bottom }}px; --story-panel: {{ section.settings.panel_color }};">
    <div class="page-width product-story__layout product-story__layout--{{ section.settings.layout }}{% if section.settings.image_position == 'right' %} product-story__layout--reverse{% endif %}">
      {%- if section.settings.image != blank and text_only == false -%}
        <div class="product-story__media">
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw' }}
        </div>
      {%- endif -%}
      <div class="product-story__copy">
        {%- if section.settings.heading != blank -%}<h2 class="product-story__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="product-story__subheading">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        {%- if body_text != blank -%}<div class="rte product-story__intro">{{ body }}</div>{%- endif -%}
        {%- if has_content == false and request.design_mode -%}
          <p class="product-story__placeholder">Add content, connect a product source, or add content blocks. This section stays hidden on the storefront until populated.</p>
        {%- endif -%}
        {%- if story_items != blank -%}
          {%- if section.settings.layout == 'offers' -%}
            <script src="{{ 'scrolling-images.js' | asset_url }}" defer="defer"></script>
            <image-marquee class="product-story__offer-marquee" data-speed="70">
              <div class="scrolling-images__track">
                <div class="scrolling-images__group product-story__items">{{ story_items }}</div>
              </div>
            </image-marquee>
          {%- elsif section.settings.layout == 'gallery' and section.settings.reference_layout -%}
            <script src="{{ 'scrolling-images.js' | asset_url }}" defer="defer"></script>
            <image-marquee class="product-story__gallery-marquee" data-speed="70">
              <div class="scrolling-images__track">
                <div class="scrolling-images__group product-story__items">{{ story_items }}</div>
              </div>
            </image-marquee>
          {%- elsif section.settings.layout == 'brand_stories' or section.settings.layout == 'reviews' -%}
            <script src="{{ 'product-story-slider.js' | asset_url }}" defer="defer"></script>
            <product-story-slider>
              <div class="product-story__items" id="StorySlider-{{ section.id }}" tabindex="0" role="region" aria-label="{{ section.settings.heading | default: 'Product stories' | escape }}">{{ story_items }}</div>
              <div class="product-story__controls" hidden>
                <button type="button" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="StorySlider-{{ section.id }}">&larr;</button>
                <span class="product-story__counter" aria-live="polite"></span>
                <button type="button" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="StorySlider-{{ section.id }}">&rarr;</button>
              </div>
            </product-story-slider>
          {%- else -%}
            <div class="product-story__items">{{ story_items }}</div>
          {%- endif -%}
          {%- if section.settings.layout == 'marquee' -%}
            <div class="product-story__items product-story__items--duplicate" aria-hidden="true" inert>{{ story_items }}</div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Product story",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    { "type": "checkbox", "id": "reference_layout", "label": "Use reference section styling", "default": false },
    { "type": "checkbox", "id": "use_product_benefit_copy", "label": "Use product benefit copy", "default": false, "info": "Three benefits: uses the title/text objects in custom.benefit_card_copy by block position. Empty entries retain block content." },
    { "type": "checkbox", "id": "use_product_images", "label": "Use product images", "default": false, "info": "Uses product images when all gallery items are empty, or fills missing images in Brand stories and Three benefits." },
    { "type": "text", "id": "subheading", "label": "Subheading or hashtag" },
    { "type": "color", "id": "panel_color", "label": "Story panel background", "default": "#FFF1F9" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover your product"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        { "value": "offers", "label": "Scrolling offer strip" },
        { "value": "brand_stories", "label": "Brand stories slider" },
        { "value": "benefits", "label": "Three benefits" },
        { "value": "text", "label": "Text-only product information" },
        { "value": "marquee", "label": "Scrolling product values" },
        { "value": "features", "label": "Mixed feature and image grid" },
        { "value": "gallery", "label": "Horizontal image gallery" },
        {
          "value": "split",
          "label": "Image and story"
        },
        {
          "value": "cards",
          "label": "Product detail cards"
        },
        {
          "value": "strip",
          "label": "Benefits or service strip"
        },
        {
          "value": "results",
          "label": "Results"
        },
        {
          "value": "faq",
          "label": "FAQ accordions"
        },
        {
          "value": "reviews",
          "label": "Testimonials"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Introduction",
      "info": "Supports dynamic sources. Literal content is shared by products using this template."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Fallback product metafield key",
      "info": "Optional key in the custom namespace, such as composition. Used when Introduction is empty."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Connect a product image metafield for product-specific imagery."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Content item",
      "settings": [
        { "type": "select", "id": "reference_card", "label": "Reference review images", "default": "none", "options": [{ "value": "none", "label": "None" }, { "value": "1", "label": "Facial oil" }, { "value": "2", "label": "Beauty gift set" }, { "value": "3", "label": "Ice globes" }, { "value": "4", "label": "Spa set" }] },
        { "type": "image_picker", "id": "portrait", "label": "Reviewer portrait" },
        { "type": "text", "id": "metafield_key", "label": "Fallback product field", "info": "Optional key in the custom namespace. Used when Content is empty; supports legacy cosmetic field names." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "product", "id": "product", "label": "Reviewed product", "info": "For testimonials. Displays the selected product image and link." },
        { "type": "select", "id": "presentation", "label": "Feature presentation", "default": "feature", "options": [{ "value": "feature", "label": "Icon and text" }, { "value": "photo", "label": "Lifestyle photo" }] },
        { "type": "range", "id": "rating", "label": "Review stars", "min": 0, "max": 5, "step": 1, "default": 0, "info": "Use the genuine review rating. Zero hides stars." },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading or question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content or answer",
          "info": "Supports dynamic sources. Empty items are hidden."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image or icon"
        },
        {
          "type": "text",
          "id": "metric",
          "label": "Result value",
          "info": "For Results layout. Enter only results supported by your own evidence."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Testimonial attribution"
        }
      ]
    },
    {
      "type": "product_detail",
      "name": "Product detail",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product detail"
        },
        {
          "type": "text",
          "id": "metafield_key",
          "label": "Product metafield key",
          "info": "Key in the custom namespace, for example composition. Empty fields are hidden."
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Optional override. Connect a dynamic source for product-specific content, or leave empty to use the metafield key above."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Supporting image",
          "info": "Connect a product image metafield using a dynamic source to show a different image for each product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product story"
    }
  ]
}
{% endschema %}
