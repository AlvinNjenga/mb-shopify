{{ 'section-product-story.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign body = section.settings.content
  assign source = product.metafields.custom[section.settings.metafield_key]
  assign body_text = body | strip_html | strip
  if body_text == blank and source.value != blank
    assign body = source | metafield_tag
  endif
  assign body_text = body | strip_html | strip
-%}
{%- capture story_items -%}
  {%- for block in section.blocks -%}
    {% render 'product-story-item', block: block, layout: section.settings.layout %}
  {%- endfor -%}
{%- endcapture -%}
{%- assign story_items = story_items | strip -%}
{%- liquid
  assign has_content = false
  if body_text != blank or section.settings.image != blank or story_items != blank
    assign has_content = true
  endif
-%}
{%- if has_content or request.design_mode -%}
  <div class="product-story color-{{ section.settings.color_scheme }} gradient" style="--story-top: {{ section.settings.padding_top }}px; --story-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="page-width product-story__layout product-story__layout--{{ section.settings.layout }}{% if section.settings.image_position == 'right' %} product-story__layout--reverse{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="product-story__media">
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw' }}
        </div>
      {%- endif -%}
      <div class="product-story__copy">
        {%- if section.settings.heading != blank -%}<h2 class="product-story__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if body_text != blank -%}<div class="rte product-story__intro">{{ body }}</div>{%- endif -%}
        {%- if has_content == false and request.design_mode -%}
          <p class="product-story__placeholder">Add content, connect a product source, or add content blocks. This section stays hidden on the storefront until populated.</p>
        {%- endif -%}
        {%- if story_items != blank -%}
          <div class="product-story__items">{{ story_items }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Product story",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover your product" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [
      { "value": "split", "label": "Image and story" },
      { "value": "cards", "label": "Ingredient or ritual cards" },
      { "value": "strip", "label": "Benefits or service strip" },
      { "value": "results", "label": "Results" },
      { "value": "faq", "label": "FAQ accordions" },
      { "value": "reviews", "label": "Testimonials" }
    ] },
    { "type": "richtext", "id": "content", "label": "Introduction", "info": "Supports dynamic sources. Literal content is shared by products using this template." },
    { "type": "text", "id": "metafield_key", "label": "Fallback product metafield key", "info": "Optional key in the custom namespace, such as ingredients. Used when Introduction is empty." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Connect a product image metafield for product-specific imagery." },
    { "type": "select", "id": "image_position", "label": "Desktop image position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [{
    "type": "item", "name": "Content item", "settings": [
      { "type": "text", "id": "heading", "label": "Heading or question" },
      { "type": "richtext", "id": "content", "label": "Content or answer", "info": "Supports dynamic sources. Empty items are hidden." },
      { "type": "image_picker", "id": "image", "label": "Image or icon" },
      { "type": "text", "id": "metric", "label": "Result value", "info": "For Results layout. Enter only results supported by your own evidence." },
      { "type": "text", "id": "author", "label": "Testimonial attribution" }
    ]
  }],
  "presets": [{ "name": "Product story" }]
}
{% endschema %}
