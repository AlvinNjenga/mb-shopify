{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-customer-reviews.css' | asset_url | stylesheet_tag }}
<div class="customer-reviews page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <slider-component>
    <div class="customer-reviews__header">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.blocks.size > 1 %}<div class="slider-buttons">
        <button type="button" name="previous" class="slider-button slider-button--prev" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-Reviews-{{ section.id }}"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></button>
        <button type="button" name="next" class="slider-button slider-button--next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-Reviews-{{ section.id }}"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></button>
      </div>{% endif %}
    </div>
    <ul id="Slider-Reviews-{{ section.id }}" class="customer-reviews__list slider slider--desktop slider--tablet" role="list">
      {% for block in section.blocks %}
        <li id="Slide-Reviews-{{ section.id }}-{{ forloop.index }}" class="customer-reviews__slide slider__slide" {{ block.shopify_attributes }}>
          <div class="customer-review">
            <div class="customer-review__body">
              {% render 'review-stars', rating: block.settings.rating %}
              <div class="customer-review__quote rte">{{ block.settings.quote }}</div>
              <h3>{{ block.settings.name | escape }}</h3>
              {% if block.settings.portrait != blank %}
                {{ block.settings.portrait | image_url: width: 200 | image_tag: loading: 'lazy', class: 'customer-review__portrait' }}
              {% elsif block.settings.reference_card != 'none' %}
                {% assign portrait_asset = 'review-portrait-' | append: block.settings.reference_card | append: '.webp' %}
                <img class="customer-review__portrait" src="{{ portrait_asset | asset_url }}" width="50" height="50" loading="lazy" alt="">
              {% endif %}
            </div>
            <div class="customer-review__product">
              {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
              {% if block.settings.product_image != blank %}
                {{ block.settings.product_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              {% elsif block.settings.reference_card != 'none' %}
                {% assign product_asset = 'review-product-' | append: block.settings.reference_card | append: '.webp' %}
                <img src="{{ product_asset | asset_url }}" width="60" height="60" loading="lazy" alt="{{ block.settings.product_title | escape }}">
              {% endif %}
              <h4>{{ block.settings.product_title | escape }}</h4>
              {% if block.settings.link != blank %}</a>{% endif %}
            </div>
          </div>
        </li>
      {% endfor %}
    </ul>
  </slider-component>
</div>
{% schema %}
{
  "name": "Customer reviews", "tag": "section", "class": "section", "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "default": 0, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px" }
  ],
  "blocks": [{ "type": "review", "name": "Review", "settings": [
    { "type": "richtext", "id": "quote", "label": "Review" },
    { "type": "text", "id": "name", "label": "Reviewer name" },
    { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "image_picker", "id": "portrait", "label": "Reviewer image" },
    { "type": "image_picker", "id": "product_image", "label": "Product image" },
    { "type": "text", "id": "product_title", "label": "Product title" },
    { "type": "url", "id": "link", "label": "Product link" },
    { "type": "select", "id": "reference_card", "label": "Reference images", "default": "none", "options": [{ "value": "none", "label": "None" }, { "value": "1", "label": "Facial oil" }, { "value": "2", "label": "Beauty gift set" }, { "value": "3", "label": "Ice globes" }, { "value": "4", "label": "Spa set" }, { "value": "5", "label": "Facial roller" }] }
  ] }],
  "presets": [{ "name": "Customer reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
