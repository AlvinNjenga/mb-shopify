{{ 'section-scrolling-images.css' | asset_url | stylesheet_tag }}
<script src="{{ 'scrolling-images.js' | asset_url }}" defer="defer"></script>

<div class="scrolling-images scrolling-images--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient" style="--scroll-padding-top: {{ section.settings.padding_top }}px; --scroll-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <image-marquee data-speed="{{ section.settings.speed }}" role="region" aria-label="{{ section.settings.accessibility_label | escape }}">
    <div class="scrolling-images__track">
      <div class="scrolling-images__group">
        {% for block in section.blocks %}
          <div class="scrolling-images__item" {{ block.shopify_attributes }}>
            {% render 'scrolling-image', block: block %}
          </div>
        {% endfor %}
      </div>
    </div>
  </image-marquee>
</div>

{% schema %}
{
  "name": "Scrolling images & brands",
  "tag": "section",
  "class": "scrolling-images-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "brands", "label": "Brand logos" }, { "value": "gallery", "label": "Image gallery" }], "default": "brands" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Our brands" },
    { "type": "range", "id": "speed", "label": "Scroll speed", "info": "Pixels per second", "min": 10, "max": 120, "step": 5, "default": 70 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [{
    "type": "image",
    "name": "Image",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset_image", "label": "Theme asset filename", "info": "Used when no image is selected." },
      { "type": "text", "id": "alt", "label": "Image description" },
      { "type": "url", "id": "link", "label": "Link" }
    ]
  }],
  "presets": [{ "name": "Scrolling images & brands", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
